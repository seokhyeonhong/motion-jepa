prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["find", ".", "-maxdepth", "3", "-type", "d", "-print"], decision="allow")
prefix_rule(pattern=["rg", "--files", "-uu", "kimodo", "-g", "!**/.git/**", "-g", "!**/__pycache__/**"], decision="allow")
prefix_rule(pattern=["sed", "-n"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "rg -n '^def |^class |size_dict|SPLIT|fps|motion_dim|save|stats|canonical|argparse|viser|inverse|skeleton' kimodo/kimodo_reimpl/preprocess_bones_seed.py kimodo/kimodo_reimpl/visualize.py ardy/ardy/motion_rep/reps/ardy_motionrep.py src/datasets/motion_dataset.py configs/mjepa.yaml main.py README.md pyproject.toml kimodo/pyproject.toml 2>/dev/null"], decision="allow")
prefix_rule(pattern=["rg", "-n", "motion|num_joints|use_skeletal_axis|permute|reshape|unsqueeze|input_dim|motion_dim", "src/train.py", "src/train_ijepa.py", "src/models/motion_transformer.py", "src/helper.py"], decision="allow")
prefix_rule(pattern=["find", "-L", "dataset/BonesSeed", "-maxdepth", "4", "-type", "d"], decision="allow")
prefix_rule(pattern=["ls", "-ld", "dataset/BonesSeed/soma_*"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "PYTHONPATH=ardy:kimodo python -c \"from pathlib import Path; import torch; from kimodo.skeleton.bvh import parse_bvh_motion; from ardy.skeleton import SOMASkeleton30,SOMASkeleton77; from ardy.motion_rep import ArdyMotionRep; p=Path('dataset/BonesSeed/soma_uniform/bvh/220705/Idle_Left_001__A017.bvh'); r,t,f=parse_bvh_motion(p); src=SOMASkeleton77(); dst=SOMASkeleton30(); r,_=src.to_standard_tpose(r); r=dst.from_SOMASkeleton77(r); rep=ArdyMotionRep(dst,30); x=rep(r[::max(1,round(float(f)/30))],t[::max(1,round(float(f)/30))],to_normalize=False,to_canonicalize=True); y=rep.inverse(x,is_normalized=False); print({'source':str(p),'source_fps':float(f),'rot_shape':tuple(r.shape),'feature_shape':tuple(x.shape),'rep_dim':rep.motion_rep_dim,'posed_shape':tuple(y['posed_joints'].shape),'finite':bool(torch.isfinite(x).all())})\""], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "ps -eo pid,ppid,etime,%cpu,%mem,rss,cmd --sort=-%cpu | head -40 && find dataset/bones_seed_motion_jepa/motions -type f -name '*.npz' 2>/dev/null | wc -l && du -sh dataset/bones_seed_motion_jepa 2>/dev/null || true && nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader 2>/dev/null || true"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "nproc && free -h && TIMEFORMAT='workers16 elapsed=%R user=%U sys=%S'; time conda run -n kimodo python dataset/preprocess_dataset.py --output /tmp/mjepa_bench_workers16 --max_per_split 10 --workers 16 --overwrite >/tmp/mjepa_bench_w16.log; TIMEFORMAT='workers32 elapsed=%R user=%U sys=%S'; time conda run -n kimodo python dataset/preprocess_dataset.py --output /tmp/mjepa_bench_workers32 --max_per_split 10 --workers 32 --overwrite >/tmp/mjepa_bench_w32.log"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "rg --files -uu .agents .codex 2>/dev/null | rg 'SKILL\\.md$|hwp|HWP' | head -100"], decision="allow")
prefix_rule(pattern=["npx", "-y", "@nomadamas/k-skill@0", "instruct"], decision="allow")
prefix_rule(pattern=["npx", "--yes", "k-skill-rhwp"], decision="allow")
